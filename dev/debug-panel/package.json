{
  "name": "@cningan/dsh-session-status-debug",
  "description": "Development-only debug panel for @cningan/dsh-session-status: two-way verification of the foreground suppression rule through the sessionStatusTest service. Never part of the release package.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test tests/panel.spec.mjs tests/plugin.spec.mjs tests/bundle.spec.mjs"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@cningan/dsh-session-status",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
