{
  "name": "@local/dsh-session-status",
  "description": "System notifications for current-session waits, completion, interruption, and connection loss, with a workbench-native notification bridge.",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "MIT"
}
