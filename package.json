{
  "name": "@cningan/dsh-session-status",
  "description": "Attention reminders for waits and stop outcomes across running sessions, delivered by Web or workbench channels.",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test",
    "check:production": "node scripts/build-client.mjs && node scripts/check-production-bundle.mjs",
    "diagnose": "node scripts/check-diagnostics.mjs"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "lib/diagnostics-contract.mjs",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "SPEC.md",
    "CONTEXT.md",
    "!dev"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
